# Copy to .env (in /opt/ytmusic-mcp/) and fill in. Never commit this file.

MCP_TRANSPORT=http

# Keep this as 127.0.0.1 - the app must NEVER bind 0.0.0.0. nginx is the
# only thing that should face the internet; it proxies to this local port.
MCP_HOST=127.0.0.1
MCP_PORT=8787

# Exact public connector URL configured in Claude.
MCP_PUBLIC_URL=https://mcp.yourdomain.com/ytmusic-mcp
# Dedicated HTTPS origin used to sandbox the submitted ChatGPT widget.
MCP_WIDGET_DOMAIN=https://mcp.yourdomain.com


# Persistent dynamic-client registrations and issued tokens. The parent
# directory must exist and be writable by the systemd service user.
OAUTH_DB_PATH=/opt/ytmusic-mcp/data/oauth.sqlite3

# Optional pre-registered client. Usually leave these unset and leave Claude's
# Client ID/Secret fields blank so it uses Dynamic Client Registration instead.
# If used, all three are required; redirect URIs are comma-separated.
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_URIS=https://client.example.com/oauth/callback

# Browser-cookie credentials and application logging.
YTMUSIC_LOG_LEVEL=INFO
# Keep dependency protocol payloads out of normal DEBUG logs. Set DEBUG only
# temporarily when investigating MCP transport internals.
MCP_LIBRARY_LOG_LEVEL=INFO

# Fernet key for per-user browser credentials. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
YTMUSIC_CREDENTIAL_KEY=REPLACE_ME

