# Copy to .env and fill in. Never commit .env.
# deploy/install.sh does this for you and generates YTMUSIC_SECRET_KEY.

MCP_TRANSPORT=http

# Keep this on 127.0.0.1: only the reverse proxy should face the internet.
# (The Docker image overrides this inside the container; see docker-compose.yml.)
MCP_HOST=127.0.0.1
MCP_PORT=8787

# Exact public URL of the MCP endpoint, as entered in Claude. Must be https.
MCP_PUBLIC_URL=https://mcp.yourdomain.com/ytmusic-mcp

# Encrypts every user's stored YouTube cookies. Generate with:
#   python -m ytmusic_mcp.cli genkey
# Back it up. If it is lost, users must re-add their cookies.
# (Older deployments called this YTMUSIC_CREDENTIAL_KEY, which is still accepted.)
YTMUSIC_SECRET_KEY=

# SQLite database holding users, OAuth clients and tokens, and the encrypted cookies.
# Defaults to ./data/ytmusic-mcp.db. (Older name OAUTH_DB_PATH is still accepted, but a
# database written by the older server layout cannot be reused: use a new file.)
# YTMUSIC_DB_PATH=/var/lib/ytmusic-mcp/ytmusic-mcp.db

# Users and passwords are managed with the admin CLI, not here:
#   python -m ytmusic_mcp.cli add-user <name>
# Each user connects their YouTube cookies in the browser the first time they sign in
# (or an admin can run: python -m ytmusic_mcp.cli set-cookies <name>).

# Optional pre-registered OAuth client. Usually leave these unset and leave
# Claude's Client ID/Secret fields blank so it uses Dynamic Client Registration.
# If used, all three are required; redirect URIs are comma-separated.
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_URIS=https://client.example.com/oauth/callback

# stdio (local) mode only: where the single local user's cookies are read from.
# YTMUSIC_AUTH_FILE=./browser.json

# Keep outbound requests on IPv4. Avoids long stalls on hosts where IPv6 is
# disabled or unreachable. Set to 0 if you need IPv6.
MCP_FORCE_IPV4=1

YTMUSIC_LOG_LEVEL=INFO
# Dependency protocol logs contain raw payloads; raise to DEBUG only temporarily.
MCP_LIBRARY_LOG_LEVEL=INFO
