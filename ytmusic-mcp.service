[Unit]
Description=YouTube Music MCP Server (personal, localhost-only backend)
After=network.target

[Service]
Type=simple
User=YOUR_LINUX_USER
WorkingDirectory=/opt/ytmusic-mcp
EnvironmentFile=/opt/ytmusic-mcp/.env
ExecStart=/usr/bin/python3 /opt/ytmusic-mcp/server.py
Restart=on-failure
RestartSec=5

# Light hardening: process can't see/touch the rest of the filesystem
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ytmusic-mcp

[Install]
WantedBy=multi-user.target
