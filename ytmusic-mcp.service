[Unit]
Description=YouTube Music MCP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu

WorkingDirectory=/home/ubuntu/prj/ytmusic-mcp
EnvironmentFile=/home/ubuntu/prj/ytmusic-mcp/.env
ExecStart=/home/ubuntu/prj/ytmusic-mcp/.venv/bin/python /home/ubuntu/prj/ytmusic-mcp/server.py

Restart=on-failure
RestartSec=5

NoNewPrivileges=true

[Install]
WantedBy=multi-user.target